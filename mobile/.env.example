# IMPORTANT: When testing on a physical Android/iOS phone, do NOT use "localhost".
# Use your computer's local network IP address instead, so the phone can reach
# the backend over Wi-Fi. Find your IP with:
#   Windows (PowerShell): ipconfig
#   Mac/Linux: ifconfig
# Your phone and computer must be connected to the SAME Wi-Fi network.

EXPO_PUBLIC_API_URL=http://192.168.x.x:5000/api
