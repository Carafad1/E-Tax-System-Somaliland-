# Flask
FLASK_ENV=development
SECRET_KEY=change-this-secret
JWT_SECRET_KEY=change-this-jwt-secret
JWT_EXPIRATION_HOURS=8

# Database
# Local development default (no installation required):
DATABASE_URL=sqlite:///etax_somaliland.db
# Production / MySQL (uncomment and configure when MySQL is available):
# DATABASE_URL=mysql+pymysql://root:password@localhost/etax_somaliland

# Admin (development credentials only - change in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234

# CORS
FRONTEND_URL=http://localhost:8081

# Currency
USD_TO_SLSH_RATE=9000

# Tax defaults
YEARLY_TAX_MIN_SLSH=100000
DAILY_TAX_MIN_SLSH=5000

# Cloud deployment (Railway/Render/etc.) — point these at a persistent
# volume so the database and uploaded profile photos survive redeploys.
# Leave unset for local development.
# DATABASE_URL=sqlite:////data/etax_somaliland.db
# STATIC_FOLDER=/data/static
AUTO_SEED_ON_STARTUP=true
